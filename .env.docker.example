APP_NAME="CIOP - Central Inteligente de Ocorrências Públicas"
APP_ENV=local
APP_KEY=base64:9Tte1Ns/7+EMg4KHwvOTtGXYCREz3ZgqfGnZpjy4qew=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Configuração do banco de dados para Docker
# Use 'pgsql' para PostgreSQL ou 'mysql' para MySQL
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# Se quiser usar o banco remoto, descomente e ajuste:
# DB_CONNECTION=pgsql
# DB_HOST=peanut.db.elephantsql.com
# DB_PORT=5432
# DB_DATABASE=kjjsyhwu
# DB_USERNAME=kjjsyhwu
# DB_PASSWORD=AJiR0PTjJ4MlQIrtBIuuhGgL-hR-AmfR

# Rota do motorista em tempo real (Fase 5): use pusher e preencha PUSHER_* para WebSocket
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (nunca commitar chaves reais; use variáveis de ambiente em produção)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher (ou Soketi): para rota do motorista em tempo real, defina BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
